# このファイルを .env にコピーして値を入れてください。.env はコミットされません。

# ElevenLabs Scribe v2（既定のプロバイダ）
# Restricted + Speech to Text のみの権限で発行できます。
ELEVENLABS_API_KEY=

# OpenAI（合議の第2エンジンとして使う場合。無くても他プロバイダは動きます）
OPENAI_API_KEY=

# Google Chirp 3 を使う場合は API キーではなく gcloud の認証を使います。
#   gcloud auth application-default login
#   gcloud services enable speech.googleapis.com --project <PROJECT_ID>
# プロジェクトIDは --project で渡します。

# Apple SpeechTranscriber は on-device のため認証不要です。

# 以下は通常このままで構いません。
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
OPENAI_BASE_URL=https://api.openai.com/v1
